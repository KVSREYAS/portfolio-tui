GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
FLASK_DEBUG=true
# Comma-separated browser origins for CORS (local dev defaults below).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:4173
# Production frontend URL (Railway, Vercel, etc.) — also added to CORS when set.
FRONTEND_URL=https://portfolio-tui-production.up.railway.app/
